# Public site URL, no trailing slash. Used for canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API). Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Used by src/lib/supabase/admin.ts. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Digits only, country code optional. Example: 8801XXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=8801700000000
