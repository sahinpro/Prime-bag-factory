# Public site URL, no trailing slash. Used for canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API). Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Used by src/lib/supabase/admin.ts. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server only. Cloudinary account for public catalog media (images).
# From the Cloudinary console → API keys. Used by src/lib/cloudinary.ts.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name

# Server only. Plan 15.2 B2: salt for the SHA-256 IP hash used as the rate-limit
# key and the ip_hash blocklist (src/server/abuse.ts). Set a long random secret
# per environment; without it a development fallback salt is used (hashed IPs
# from one environment then match another's, so never ship the fallback).
RATE_LIMIT_SALT=generate-a-long-random-string

# Digits only, country code optional. Example: 8801XXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=8801700000000

# Server only. Resend (https://resend.com) for new-quote email alerts.
# Optional: without these the app runs, emails are skipped and the admin
# bell still works. Used by src/server/notifications.ts.
RESEND_API_KEY=re_your-api-key
# Verified sender on the Resend domain, e.g. "Prime Bag Factory <quotes@primebagfactorybd.com>"
MAIL_FROM="Prime Bag Factory <onboarding@resend.dev>"
