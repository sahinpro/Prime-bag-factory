# Local-only test environment (plan 15.2 A2).
# Copy to `.env.test` (gitignored) and adjust if needed. `bunx supabase start`
# prints the keys — the values below are the Supabase CLI's documented local
# defaults (CLI 2.121); they are NOT secrets and never leave this machine.
# Tests abort unless NEXT_PUBLIC_SUPABASE_URL is http://localhost / 127.0.0.1.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
SUPABASE_SERVICE_ROLE_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz
NEXT_PUBLIC_WHATSAPP_NUMBER=8801700000000
# Staff login for the authenticated admin e2e project. This user is created by
# supabase/seed.sql in EVERY local/CI database (plan 15.2 A3) and exists nowhere
# else — seeds never reach hosted projects. Not a secret: local stack only.
E2E_STAFF_EMAIL=e2e-staff@primebagfactory.test
E2E_STAFF_PASSWORD=E2e-Local-Stack-Only!
